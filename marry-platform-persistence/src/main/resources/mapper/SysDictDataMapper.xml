<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.marry.persistence.mapper.SysDictDataMapper">

    <resultMap id="dictResult" type="com.marry.domain.entity.SysDictData">
        <id property="id" column="id"/>
        <result property="dictType" column="dict_type"/>
        <result property="label" column="label"/>
        <result property="value" column="value"/>
        <result property="cssClass" column="css_class"/>
        <result property="listClass" column="list_class"/>
        <result property="isDefault" column="is_default"/>
        <result property="orderNum" column="order_num"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <select id="selectByDictType" resultMap="dictResult">
        SELECT * FROM sys_dict_data
        WHERE dict_type = #{dictType} AND status = 1 AND del_flag = 0
        ORDER BY order_num ASC
    </select>

</mapper>