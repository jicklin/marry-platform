# ============================================================
# Local environment for docker compose.
# Copy to .env (same directory) and edit before `docker compose up`.
# ============================================================

# --- PostgreSQL credentials (also used by the backend container) ---
POSTGRES_DB=marry_platform
POSTGRES_USER=marry
POSTGRES_PASSWORD=marry123

# --- Persistent storage paths on the HOST ---
#
# Windows-style paths (D:\...) are auto-converted to /mnt/d/... when
# up.sh is run from inside WSL (the WSL docker daemon only mounts Unix
# paths). Native Linux/macOS hosts use absolute Unix paths directly.
# Relative paths are resolved relative to this directory.
#
# Examples:
#   PG_DATA_PATH=D:\my-data\marry-pg          # WSL: -> /mnt/d/my-data/marry-pg
#   PG_DATA_PATH=/Volumes/external/pg          # macOS native
#   PG_DATA_PATH=/var/lib/marry/pg            # Linux native
PG_DATA_PATH=D:\dockerdata\marryplatform
UPLOADS_PATH=Z:\马呦呦上学记

# --- File storage config (forwarded to the backend) ---
MARRY_FILE_BUCKET=platform
MARRY_FILE_EVENT_ROOT=events
MARRY_FILE_PUBLIC_BASE=/api/static/upload/

# --- JWT signing secret — MUST be at least 32 chars in production ---
JWT_SECRET=ccucZJFr8DXdfzh0nSvUEf1NP2jdyUCR

# --- Host port that the SPA listens on (Vite default is 5173) ---
FRONTEND_PORT=5173